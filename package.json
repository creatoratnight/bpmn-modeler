{
  "name": "bpmn-modeler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "dev:e2e": "vite --mode e2e --port 5174 --strictPort",
    "emulators": "firebase emulators:start --only auth,database --project demo-bpmn",
    "test:e2e": "firebase emulators:exec --only auth,database --project demo-bpmn \"playwright test --project=chromium\"",
    "test:e2e:ui": "firebase emulators:exec --only auth,database --project demo-bpmn \"playwright test --project=chromium --ui\"",
    "test:e2e:report": "playwright show-report",
    "test:collab": "firebase emulators:exec --only auth,database --project demo-bpmn \"playwright test --project=collab\"",
    "demo": "firebase emulators:exec --only auth,database --project demo-bpmn \"playwright test --project=demo\"",
    "screenshots": "firebase emulators:exec --only auth,database --project demo-bpmn \"playwright test --project=screenshots\""
  },
  "dependencies": {
    "@carbon/react": "^1.53.1",
    "axios": "^1.18.1",
    "base64-arraybuffer": "^1.0.2",
    "bpmn-js": "^17.0.2",
    "bpmn-js-color-picker": "^0.7.2",
    "diagram-js-minimap": "^5.2.0",
    "dmn-js": "^15.1.0",
    "firebase": "^10.14.1",
    "pako": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.0",
    "toastr": "^2.1.4",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "firebase-tools": "^15.22.1",
    "sass": "^1.71.1",
    "sass-loader": "^14.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.4.21"
  },
  "overrides": {
    "protobufjs": ">=7.5.5",
    "undici": ">=6.21.1",
    "braces": ">=3.0.3",
    "picomatch": ">=2.3.2",
    "form-data": ">=4.0.6",
    "immutable": ">=4.3.8"
  }
}
